# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Shared Teamwork read-only connection used by every signed-in user.
VITE_TEAMWORK_SITE_URL=https://bestworldsweb.teamwork.com
VITE_TEAMWORK_API_KEY=

# Optional. If set, TW Wiki writes full operational articles instead of the local fallback.
OPENAI_API_KEY=

# Neon Postgres (Vercel Marketplace). Server-only — never prefix with VITE_.
# Use the pooled connection string. Required to persist ratings and the Teamwork snapshot.
DATABASE_URL=

# Optional server-only Teamwork key (falls back to VITE_TEAMWORK_*). Used by the daily snapshot job.
# TEAMWORK_SITE_URL=
# TEAMWORK_API_KEY=

# Optional. Vercel Cron sends Authorization: Bearer CRON_SECRET to /api/sync once a day.
# CRON_SECRET=
